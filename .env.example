# Any OpenAI-compatible endpoint: OpenAI, DeepSeek, OpenRouter, a local gateway...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Model for the background review. Empty = the main model (recommended:
# the review then reuses the main conversation's prompt cache).
REVIEW_MODEL=

# Where MEMORY.md, USER.md, skills/ and state.db live.
MINI_HERMES_HOME=.mini-hermes
